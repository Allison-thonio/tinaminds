# Tina Like Minds Empowerment Initiative: Member Registry
# Environment Variables Configuration Guide (Appendix B)

# ==============================================================================
# REQUIRED PRODUCTION VARIABLES
# ==============================================================================

# Public URL of the deployed application (used in emails and admin origin verification)
SITE_URL=https://registry.tinalikeminds.org

# Supabase Project URL (found in Supabase Dashboard > Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (SERVER-ONLY. Bypasses RLS. NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend API Key for sending emails
RESEND_API_KEY=re_your_resend_api_key

# Verified Resend Sender Address
RESEND_FROM=Tina Like Minds <registry@tinalikeminds.org>

# Email address(es) to receive new registration notifications (comma-separated if multiple)
ADMIN_NOTIFY_EMAIL=admin@tinalikeminds.org

# Master Admin Password for /admin/login (min 16 characters recommended)
ADMIN_PASSWORD=change-to-a-very-strong-passphrase

# Secret key for signing admin JWT sessions (minimum 32 characters)
ADMIN_SESSION_SECRET=change-to-a-secure-random-secret-key-at-least-32-chars-long

# ==============================================================================
# RECOMMENDED / OPTIONAL VARIABLES
# ==============================================================================

# WhatsApp Master Group Invite Link (returned to member on successful registration)
WHATSAPP_GROUP_INVITE_URL=https://chat.whatsapp.com/your-invite-code

# Admin WhatsApp number (digits only with country code, e.g. 2348012345678)
NEXT_PUBLIC_ADMIN_WHATSAPP=2348012345678

# Public support email displayed on the site and in member emails
NEXT_PUBLIC_SUPPORT_EMAIL=support@tinalikeminds.org

# Cloudflare Turnstile bot protection keys (optional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis for distributed rate limiting (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salt for hashing IP addresses in registration records (optional)
IP_HASH_SALT=your-random-ip-hash-salt

# Last updated date text for the privacy page (optional)
NEXT_PUBLIC_PRIVACY_UPDATED=November 2026
